<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing"
        app:use_controller="false"
        app:resize_mode="fit" />

    <LinearLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#18000000"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="#55000000"
            android:paddingHorizontal="8dp">
            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:tint="#FFFFFF"
                android:contentDescription="Close" />
            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/btnPip"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="▣"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:contentDescription="Picture in picture" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/gestureText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="#CC171923"
                android:paddingHorizontal="18dp"
                android:paddingVertical="10dp"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/btnBack"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:text="↶ 10"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:background="?attr/selectableItemBackgroundBorderless" />
                <TextView
                    android:id="@+id/btnPlay"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginHorizontal="18dp"
                    android:gravity="center"
                    android:text="Ⅱ"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:background="@drawable/player_play_bg" />
                <TextView
                    android:id="@+id/btnForward"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:text="10 ↷"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#66000000"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">
            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:max="1000"
                android:progress="0"
                android:progressTint="#6366F1"
                android:thumbTint="#FFFFFF"
                android:progressBackgroundTint="#77FFFFFF" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/currentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/btnRemaining"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Elapsed / Remaining"
                    android:textColor="#BFFFFFFF"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/totalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/btnLock"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="LOCK"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/btnFit"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="FIT"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/btnSpeed"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="1.0×"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="42dp"
        android:layout_height="150dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="4dp"
        android:gravity="center"
        android:orientation="vertical"
        android:background="#55000000">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
        <SeekBar
            android:id="@+id/brightnessBar"
            android:layout_width="130dp"
            android:layout_height="28dp"
            android:rotation="270"
            android:max="100"
            android:progress="65"
            android:progressTint="#A5A6FF"
            android:thumbTint="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="42dp"
        android:layout_height="150dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="4dp"
        android:gravity="center"
        android:orientation="vertical"
        android:background="#55000000">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♪"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
        <SeekBar
            android:id="@+id/volumeBar"
            android:layout_width="130dp"
            android:layout_height="28dp"
            android:rotation="270"
            android:max="100"
            android:progress="50"
            android:progressTint="#A5A6FF"
            android:thumbTint="#FFFFFF" />
    </LinearLayout>
</FrameLayout>