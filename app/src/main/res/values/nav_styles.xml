<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NavLabelActive" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="NavLabelInactive" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>
    <style name="DownloadFilter">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
